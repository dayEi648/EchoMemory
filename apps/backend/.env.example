# Database（开发环境）
# 要求先创建名为 echomemory 的 PostgreSQL 数据库
# 若使用本地默认 postgres 用户，替换 <password> 为实际密码
DATABASE_URL=postgresql+psycopg2://postgres:<password>@localhost:5432/echomemory

# Cache
# Redis 默认使用 0 号数据库，按需修改
REDIS_URL=redis://localhost:6379/0

# Security
# JWT 签名密钥，请替换为一串随机且足够长的字符串，不可使用默认值
SECRET_KEY=<change-me-to-a-random-string>

# OSS（阿里云对象存储服务）
# 文件上传功能依赖此配置，若暂不需要文件上传可保持空值
OSS_ACCESS_KEY_ID=<your-access-key-id>
OSS_ACCESS_KEY_SECRET=<your-access-key-secret>
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET_NAME=<your-bucket-name>
OSS_AVATAR_PREFIX=avatars

# LLM（DeepSeek）
# DeepSeek API 密钥，用于 Agent 与 AI 回声功能；请替换为实际密钥
DEEPSEEK_API_KEY=<your-deepseek-api-key>
# DeepSeek API 基础地址，国内直连节点，一般无需修改
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 思考模型与快速模型 ID，一般无需修改
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash

# DeepSeek 调用默认参数（可选，一般无需修改）
DEEPSEEK_DEFAULT_TEMPERATURE=0.7
DEEPSEEK_DEFAULT_TIMEOUT=60.0
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_THINKING_TYPE=enabled
