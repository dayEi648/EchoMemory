# Database（开发环境）
# 要求先创建名为 echomemory 的 PostgreSQL 数据库
# 若使用本地默认 postgres 用户，替换 <password> 为实际密码
DATABASE_URL=postgresql+psycopg2://postgres:<password>@localhost:5432/echomemory

# Cache
# Redis 默认使用 0 号数据库，按需修改
REDIS_URL=redis://localhost:6379/0

# Security
# JWT 签名密钥，请替换为一串随机且足够长的字符串，不可使用默认值
SECRET_KEY=<change-me-to-a-random-string>

# OSS（阿里云对象存储服务）
# 文件上传功能依赖此配置，若暂不需要文件上传可保持空值
OSS_ACCESS_KEY_ID=<your-access-key-id>
OSS_ACCESS_KEY_SECRET=<your-access-key-secret>
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET_NAME=<your-bucket-name>
OSS_AVATAR_PREFIX=avatars

# LLM（DeepSeek）
# DeepSeek API 密钥，用于 Agent 与 AI 回声功能；请替换为实际密钥
DEEPSEEK_API_KEY=<your-deepseek-api-key>
# DeepSeek API 基础地址，国内直连节点，一般无需修改
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 思考模型与快速模型 ID，一般无需修改
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash

# DeepSeek 调用默认参数（可选，一般无需修改）
DEEPSEEK_DEFAULT_TEMPERATURE=0.7
DEEPSEEK_DEFAULT_TIMEOUT=60.0
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_THINKING_TYPE=enabled

# Agent 内容审核（可选）
CONTENT_MODERATION_MODEL=deepseek-v4-flash
CONTENT_MODERATION_TIMEOUT_SECONDS=30
CONTENT_MODERATION_POLL_SECONDS=1
CONTENT_MODERATION_BATCH_SIZE=10
CONTENT_MODERATION_LEASE_SECONDS=300

# IQS 联网搜索 MCP（阿里云信息查询服务）
# 在 IQS 控制台创建 API-Key，约 5 分钟后生效
IQS_API_KEY=<your-iqs-api-key>
IQS_MCP_URL=https://iqs-mcp.aliyuncs.com/mcp-servers/iqs-mcp-server-search
IQS_MCP_TOOL_NAME=common_search

# Embedding（阿里云 DashScope text-embedding-v4）
# DashScope API 密钥，用于 RAG 向量生成；请替换为实际密钥
DASHSCOPE_API_KEY=<your-dashscope-api-key>
# OpenAI 兼容端点，国内一般无需修改
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Embedding 模型与维度（可选，一般无需修改）
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
# 单次批量嵌入最大条数（text-embedding-v4 上限 25）
EMBEDDING_BATCH_SIZE=25
